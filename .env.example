# Copy to .env. Git ignores .env; only this example is committed.

# Model calls (the gate's classify step now; the screening pass later) go
# through OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Adzuna job search API. Register at https://developer.adzuna.com; the
# dashboard shows an application id and lets you create keys.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
